# Copy to .env and fill values. Never commit real .env.

# Required — used to sign JWTs
JWT_SECRET=change-this-to-a-long-random-string-for-sih-demo

# Optional — Claude AI for assistant + vision. Leave empty for rule-based fallbacks.
ANTHROPIC_API_KEY=

# Server port
PORT=3000

# Allowed frontend origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
